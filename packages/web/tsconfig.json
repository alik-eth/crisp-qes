{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true
  },
  "include": ["src/**/*", "i18n/**/*"],
  "// exclude": "voteProve.worker.ts is built by vite.voteworker.config.ts against the fork's v3 toolchain (@crisp-e3/sdk etc.), not the main app graph — keep it out of the app typecheck.",
  "exclude": ["src/worker/voteProve.worker.ts"]
}
