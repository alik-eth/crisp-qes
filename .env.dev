# docker-compose-dev values — LOCALHOST DEV ONLY. No real secrets here:
# anvil[0] is the universally-known foundry test key; 0x111…11 is a throwaway
# local deployer. The OPRF dev V3_THRESHOLD_SEED / V3_ATTESTER_KEY are NOT set —
# the service uses its labelled dev fallbacks in non-production (so no key is
# committed); we only pin the attester ADDRESS the registry must trust.
#
# Used via:  docker compose --env-file .env.dev -f docker-compose.dev.yml up --build

# --- chain ---
CHAIN_ID=31337

# --- dev keys (LOCAL TEST ONLY, zero value) ---
ANVIL0_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
ANVIL0_ADDR=0xf39Fd6e51aad88F6F4ce6aB8827279cffFb92266
# dedicated registry deployer (not an anvil default → nonce starts at 0 → addrs deterministic)
DEPLOYER_KEY=0x1111111111111111111111111111111111111111111111111111111111111111
DEPLOYER_ADDR=0x19E7E376E7C213B7E7e7e46cc70A5dD086DAff2A

# --- deterministic contract addresses (from DEPLOYER nonce 0/1; CRISP from FHE supervisor) ---
ENROLLMENT_REGISTRY=0xAE519FC2Ba8e6fFE6473195c092bF1BAe986ff90
BALLOT_REGISTRY=0x73b647cbA2FE75Ba05B8e12ef8F8D6327D6367bF
# NOTE: the CRISP-QES program is deployed by the FHE supervisor's crisp_qes_deploy.sh
# (NOT the deterministic init), so it DRIFTS on every cold reset. Resync from the
# container's enclave.config.yaml e3_program after a `--build`/volume reset:
#   docker compose ... exec -T fhe grep -A1 e3_program /app/examples/CRISP/enclave.config.yaml
CRISP_QES_PROGRAM=0xc351628EB244ec633d5f21fBD6621e1a683B1181
# v2 petition flow (verifier + registry wired to the EXISTING EnrollmentRegistry).
# Deterministic from the deployer after enrollment+ballot (verifier then petition).
V2_VERIFIER=0x08425D9Df219f93d5763c3e85204cb5B4cE33aAa
PETITION_REGISTRY_V2=0xA10A3B175F0f2641Cf41912b887F77D8ef34FAe8

# --- enrollment registry config ---
# oprfAttester = address of the OPRF service's dev V3_ATTESTER_KEY fallback.
ENROLL_ATTESTER=0xbcD7A4C1e3946c0BaaAC68E0D9A774D3d712f357
# canonical depth-20 Pedersen zero-tree root (service/merkle.mjs GENESIS_ROOT).
GENESIS_ROOT=0x1b49e706af69da35927cdf2b28b02fb2647245ac0ccbc376d062031185d3cd84

# --- enrollment epoch (web challenge must match the OPRF service default) ---
OPRF_ENROLLMENT_EPOCH=v3-2026
# vestigial v2 MITM pin; harmless for v3 threshold enroll.
OPRF_PUBKEY=0xbe42b0024b2e4ee2483021fefbf40a5bec6f51fe08d35237027a667712694456
