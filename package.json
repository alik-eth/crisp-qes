{
  "name": "crisp-qes",
  "private": true,
  "version": "0.0.0",
  "description": "Privacy-preserving petition signatures backed by Ukrainian Diia QES, on-chain on Base.",
  "license": "MIT",
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "circuit:check": "pnpm --filter @crisp-qes/circuit check",
    "circuit:compile": "pnpm --filter @crisp-qes/circuit compile",
    "contracts:build": "pnpm --filter @crisp-qes/contracts build",
    "contracts:test": "pnpm --filter @crisp-qes/contracts test",
    "sdk:build": "pnpm --filter @crisp-qes/sdk build",
    "lotl:build": "pnpm --filter @crisp-qes/lotl-flattener build",
    "oprf:dev": "pnpm --filter @crisp-qes/oprf dev",
    "oprf:test": "pnpm --filter @crisp-qes/oprf test",
    "web:dev": "pnpm --filter @crisp-qes/web dev",
    "relayer:dev": "pnpm --filter @crisp-qes/relayer dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3"
    ]
  }
}
